# Neon Database Configuration
DATABASE_URL="postgresql://neondb_owner:your-password@ep-xxx.us-east-2.aws.neon.tech/krown_pos?sslmode=require"

# REQUIRED: random secret, minimum 32 characters. Never commit the real value.
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
JWT_EXPIRY_HOURS="24"

# Image Upload API Key (ImgBB / Cloudinary)
IMGBB_API_KEY=""

# Gemini AI API Key
GEMINI_API_KEY=""

# App Base URL
APP_URL="http://localhost:3000"

# Gmail SMTP Configuration (for transactional emails)
# To create a Google App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification
# 3. Go to https://myaccount.google.com/apppasswords
# 4. Create a new app password for "Mail"
# 5. Copy the 16-character password below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="KROWN POS <your-email@gmail.com>"
